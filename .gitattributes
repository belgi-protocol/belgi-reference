## BELGI: .gitattributes

# Default: normalize text files to LF
* text=auto eol=lf

# --- Code / docs / configs (LF) ---
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.ps1   text eol=lf
*.sh    text eol=lf
*.json  text eol=lf

# --- True binaries ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
