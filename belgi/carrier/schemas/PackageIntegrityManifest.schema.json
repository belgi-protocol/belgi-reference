{
  "$schema": "https://belgi.dev/schemas/carrier/rc.v2/BELGI-JSON-Schema-Dialect.schema.json",
  "$id": "https://belgi.dev/schemas/carrier/rc.v2/PackageIntegrityManifest.schema.json",
  "title": "BELGI package integrity manifest",
  "description": "Package-level integrity authority keyed by replay-relevant member canonical reference.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "package-integrity-manifest"
    },
    "bindings": {
      "title": "Integrity bindings",
      "description": "Integrity bindings keyed by replay-relevant member canonical reference.",
      "type": "object",
      "propertyNames": {
        "$ref": "Common.schema.json#/$defs/canonicalReference"
      },
      "additionalProperties": {
        "$ref": "#/$defs/packageIntegrityBindingRecord"
      },
      "minProperties": 1
    }
  },
  "required": [
    "kind",
    "bindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "packageIntegrityBindingRecord": {
      "title": "Package integrity binding record",
      "description": "Integrity binding payload for one replay-relevant member.",
      "type": "object",
      "properties": {
        "algorithmIdentifier": {
          "title": "Digest algorithm identifier",
          "description": "Stable identifier of the digest algorithm, paired with algorithmDesignator.",
          "$ref": "Common.schema.json#/$defs/stableIdentifier"
        },
        "algorithmDesignator": {
          "$ref": "Common.schema.json#/$defs/immutableDesignator"
        },
        "boundObject": {
          "$ref": "Common.schema.json#/$defs/boundObjectKind"
        },
        "boundValueHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})+(?![\\s\\S])"
        },
        "canonicalizationRuleIdentifier": {
          "title": "Canonicalization rule identifier",
          "description": "Stable identifier of the canonicalization rule used by this canonical-projection binding, paired with canonicalizationRuleDesignator.",
          "$ref": "Common.schema.json#/$defs/stableIdentifier"
        },
        "canonicalizationRuleDesignator": {
          "title": "Canonicalization rule designator",
          "description": "Immutable designator of the canonicalization rule used by this integrity binding when the bound object is a canonical projection. This binding-level rule is distinct from any member-inventory projection rule metadata.",
          "$ref": "Common.schema.json#/$defs/immutableDesignator"
        }
      },
      "required": [
        "algorithmIdentifier",
        "algorithmDesignator",
        "boundObject",
        "boundValueHex"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "boundObject": {
                "const": "canonical-projection"
              }
            },
            "required": [
              "boundObject"
            ]
          },
          "then": {
            "required": [
              "canonicalizationRuleIdentifier",
              "canonicalizationRuleDesignator"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "boundObject": {
                "const": "exact-preserved-octets"
              }
            },
            "required": [
              "boundObject"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "canonicalizationRuleIdentifier"
                  ]
                },
                {
                  "required": [
                    "canonicalizationRuleDesignator"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "kind": "package-integrity-manifest",
      "bindings": {
        "pkg:pkg-demo#claim-record": {
          "algorithmIdentifier": "https://belgi.dev/ids/algorithm/digest/sha-256",
          "algorithmDesignator": {
            "uri": "https://belgi.dev/specs/spec-0.3/sha256-e3fc0568fe6fec523e11a916978bca80b4b54b5a19f5a1b125c1093515ab9958/BELGI-Companion-Package-Integrity-Anchor-Verification.md",
            "digest": {
              "algorithmId": "sha256",
              "digestValue": "e3fc0568fe6fec523e11a916978bca80b4b54b5a19f5a1b125c1093515ab9958"
            }
          },
          "boundObject": "exact-preserved-octets",
          "boundValueHex": "1111111111111111111111111111111111111111111111111111111111111111"
        },
        "pkg:pkg-demo#judged-object-carrier-root": {
          "algorithmIdentifier": "https://belgi.dev/ids/algorithm/digest/sha-256",
          "algorithmDesignator": {
            "uri": "https://belgi.dev/specs/spec-0.3/sha256-e3fc0568fe6fec523e11a916978bca80b4b54b5a19f5a1b125c1093515ab9958/BELGI-Companion-Package-Integrity-Anchor-Verification.md",
            "digest": {
              "algorithmId": "sha256",
              "digestValue": "e3fc0568fe6fec523e11a916978bca80b4b54b5a19f5a1b125c1093515ab9958"
            }
          },
          "boundObject": "exact-preserved-octets",
          "boundValueHex": "2222222222222222222222222222222222222222222222222222222222222222"
        }
      }
    }
  ]
}
